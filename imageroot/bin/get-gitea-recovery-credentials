"""Return the module-owned Gitea recovery credentials."""

import json
import sys

from gitea_auth import (
    RECOVERY_USERNAME,
    ReconcileError,
    read_recovery_credentials,
    read_setup_mode,
)


def main() -> int:
    try:
        if read_setup_mode() != "managed":
            raise ReconcileError(
                "Recovery credentials are available only in NS8-managed setup mode."
            )
        credentials = read_recovery_credentials()
    except ReconcileError as exc:
        print(f"Could not read Gitea recovery credentials: {exc}", file=sys.stderr)
        return 1
    except Exception as exc:
        print(
            "Could not read Gitea recovery credentials because of an unexpected "
            f"{type(exc).__name__}.",
            file=sys.stderr,
        )
        return 1

    json.dump(
        {
            "available": credentials is not None,
            "username": RECOVERY_USERNAME,
            "password": credentials["password"] if credentials else "",
        },
        fp=sys.stdout,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
