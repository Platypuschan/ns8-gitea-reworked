import os

import agent


protocols = {
    "none": "smtp",
    "starttls": "smtp+starttls",
    "tls": "smtps",
}

# The local replica allows startup even when the cluster leader is unavailable.
rdb = agent.redis_connect(use_replica=True)
smtp = agent.get_smarthost_settings(rdb)

config = {
    "GITEA__mailer__ENABLED": "true" if smtp["enabled"] else "false",
}

if smtp["enabled"]:
    try:
        sender = agent.read_envfile("gitea-setup.env").get("GITEA_MAILER_FROM", "")
    except FileNotFoundError:
        sender = ""
    # NS8's own mail sender uses no-reply@hostname. Always supply a valid
    # address: Gitea otherwise derives FROM from the SMTP username, which
    # need not be an email address and can prevent Gitea from starting.
    sender = sender or f"no-reply@{os.environ.get('TRAEFIK_HOST') or 'localhost.invalid'}"
    encryption = str(smtp.get("encrypt_smtp", "starttls")).lower()
    config.update(
        {
            "GITEA__mailer__FROM": sender,
            "GITEA__mailer__PROTOCOL": protocols.get(encryption, "smtp+starttls"),
            "GITEA__mailer__SMTP_ADDR": str(smtp.get("host", "")),
            "GITEA__mailer__SMTP_PORT": str(smtp.get("port", "")),
            "GITEA__mailer__USER": str(smtp.get("username", "") or ""),
            "GITEA__mailer__PASSWD": str(smtp.get("password", "") or ""),
            "GITEA__mailer__FORCE_TRUST_SERVER_CERT": (
                "false" if smtp.get("tls_verify", True) else "true"
            ),
        }
    )

envfile = "smarthost.env"
agent.write_envfile(envfile + ".tmp", config)
os.chmod(envfile + ".tmp", 0o600)
os.replace(envfile + ".tmp", envfile)
