"""Generate and activate a new password for the Gitea recovery account."""

import json
import sys

from gitea_auth import (
    RECOVERY_USERNAME,
    ReconcileError,
    authentication_lock,
    reset_recovery_password,
)


def main() -> int:
    try:
        with authentication_lock():
            reset_recovery_password()
    except ReconcileError as exc:
        print(f"Could not reset the Gitea recovery password: {exc}", file=sys.stderr)
        return 1
    except Exception as exc:
        print(
            "Could not reset the Gitea recovery password because of an unexpected "
            f"{type(exc).__name__}.",
            file=sys.stderr,
        )
        return 1

    json.dump(
        {"changed": True, "username": RECOVERY_USERNAME},
        fp=sys.stdout,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
