import json
import os
import sys

import agent


data = json.load(sys.stdin)
host = data["host"].strip().rstrip(".")
ssh_port = os.environ["SSH_TCP_PORT"]

try:
    gitea = agent.read_envfile("gitea.env")
except FileNotFoundError:
    gitea = {}

# These values were managed by older module versions. Smarthost settings are
# now regenerated independently in smarthost.env.
gitea.pop("LOCAL_ROOT_URL", None)
for key in list(gitea):
    if key.startswith("GITEA__mailer__"):
        del gitea[key]

gitea.update(
    {
        "GITEA__server__DOMAIN": host,
        "GITEA__server__ROOT_URL": f"https://{host}/",
        "GITEA__server__PUBLIC_URL_DETECTION": "never",
        "GITEA__server__DISABLE_SSH": "false",
        "GITEA__server__SSH_DOMAIN": host,
        # The container listens on 22; this is the externally allocated NS8 port.
        "GITEA__server__SSH_PORT": ssh_port,
        # Private-by-default policy for the intended local repository service.
        "GITEA__service__DISABLE_REGISTRATION": "true",
        "GITEA__service__REQUIRE_SIGNIN_VIEW": "true",
        "GITEA__repository__DEFAULT_PRIVATE": "private",
    }
)
agent.write_envfile("gitea.env", gitea)
os.chmod("gitea.env", 0o600)
