import json
import os
import secrets
import sys

import agent


# Consume and validate the action input, even though no fields are currently used.
json.load(sys.stdin)

ports = [port.strip() for port in os.environ.get("TCP_PORTS", "").split(",") if port]
agent.assert_exp(
    len(ports) == 2,
    "The module requires exactly two allocated TCP ports (web and Git SSH).",
)
agent.set_env("SSH_TCP_PORT", ports[1])

postgres_user = "postgres"
postgres_password = secrets.token_hex(32)
postgres_db = "gitea"

agent.write_envfile(
    "database.env",
    {
        "POSTGRES_USER": postgres_user,
        "POSTGRES_PASSWORD": postgres_password,
        "POSTGRES_DB": postgres_db,
    },
)
os.chmod("database.env", 0o600)

# Both containers share one Podman pod, therefore PostgreSQL is reachable on loopback.
agent.write_envfile(
    "gitea-db.env",
    {
        "GITEA__database__DB_TYPE": "postgres",
        "GITEA__database__HOST": "127.0.0.1:5432",
        "GITEA__database__NAME": postgres_db,
        "GITEA__database__USER": postgres_user,
        "GITEA__database__PASSWD": postgres_password,
    },
)
os.chmod("gitea-db.env", 0o600)

# The first UI configuration requires a one-time choice between Gitea's
# interactive installer and the NS8-managed setup. Older module versions do
# not have this file and are migrated to managed mode.
agent.write_envfile(
    "gitea-setup.env",
    {"GITEA_SETUP_MODE": "pending"},
)
os.chmod("gitea-setup.env", 0o600)
