import json
import os
import sys

import agent


AUTH_DEFAULTS = {
    "GITEA_AUTH_ENABLED": "false",
    "GITEA_AUTH_SOURCE_MANAGED": "false",
    "GITEA_AUTH_DOMAIN": "",
    "GITEA_AUTH_USER_GROUP": "gitea-user",
    "GITEA_AUTH_ADMIN_GROUP": "gitea-admin",
    "GITEA_AUTH_USER_SEARCH_BASE": "",
    "GITEA_AUTH_NESTED_GROUPS": "false",
}

SETUP_MODES = {"pending", "manual", "managed"}


def parse_bool(value):
    return str(value).strip().lower() in {"1", "true", "yes", "on"}


ssh_port = os.environ.get("SSH_TCP_PORT", "")
setup_environment = agent.read_envfile("gitea-setup.env")
setup_mode = setup_environment.get("GITEA_SETUP_MODE", "").strip().lower()
agent.assert_exp(setup_mode in SETUP_MODES, "The stored Gitea setup mode is invalid.")

try:
    auth_environment = agent.read_envfile("gitea-auth.env")
except FileNotFoundError:
    auth_environment = {}
auth = AUTH_DEFAULTS | auth_environment

configuration = {
    "host": os.environ.get("TRAEFIK_HOST", ""),
    "http2https": os.environ.get("TRAEFIK_HTTP2HTTPS") == "True",
    "lets_encrypt": os.environ.get("TRAEFIK_LETS_ENCRYPT") == "True",
    "ssh_port": int(ssh_port) if ssh_port.isdigit() else 0,
    "setup_mode": setup_mode,
    "mailer_from": setup_environment.get("GITEA_MAILER_FROM", ""),
    "ad_enabled": parse_bool(auth["GITEA_AUTH_ENABLED"]),
    "ad_domain": auth["GITEA_AUTH_DOMAIN"].strip(),
    "ad_user_group": auth["GITEA_AUTH_USER_GROUP"].strip(),
    "ad_admin_group": auth["GITEA_AUTH_ADMIN_GROUP"].strip(),
    "ad_user_search_base": auth["GITEA_AUTH_USER_SEARCH_BASE"].strip(),
    "ad_nested_groups": parse_bool(auth["GITEA_AUTH_NESTED_GROUPS"]),
}


def smarthost_available():
    try:
        smtp = agent.get_smarthost_settings(agent.redis_connect(use_replica=True))
    except Exception:
        return False
    return bool(smtp.get("enabled")) and bool(str(smtp.get("host", "")).strip())


configuration["smarthost_mail"] = setup_mode == "managed" and parse_bool(
    setup_environment.get("GITEA_MAIL_SMARTHOST", "false")
)
configuration["smarthost_available"] = smarthost_available()

json.dump(configuration, fp=sys.stdout)
