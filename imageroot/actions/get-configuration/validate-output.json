{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Get gitea settings",
  "$id": "http://nethserver.org/json-schema/task/input/gitea/get-configuration",
  "description": "Get gitea settings",
  "examples": [
    {
      "host": "gitea.domain.org",
      "http2https": true,
      "lets_encrypt": true,
      "ssh_port": 20001,
      "setup_mode": "managed",
      "ad_enabled": true,
      "ad_domain": "ad.domain.org",
      "ad_user_group": "gitea-user",
      "ad_admin_group": "gitea-admin",
      "ad_user_search_base": "CN=Users,DC=ad,DC=domain,DC=org",
      "ad_nested_groups": false
    }
  ],
  "type": "object",
  "required": [
    "host",
    "http2https",
    "lets_encrypt",
    "ssh_port",
    "setup_mode",
    "ad_enabled",
    "ad_domain",
    "ad_user_group",
    "ad_admin_group",
    "ad_user_search_base",
    "ad_nested_groups"
  ],
  "properties": {
    "host": {
      "type": "string",
      "description": "Host name for the application, like 'gitea.domain.org'",
      "format": "idn-hostname"
    },
    "lets_encrypt": {
      "type": "boolean",
      "title": "Let's Encrypt certificate",
      "description": "Request a valid Let's Encrypt certificate."
    },
    "http2https": {
      "type": "boolean",
      "title": "HTTP to HTTPS redirection",
      "description": "Redirect all the HTTP requests to HTTPS"
    },
    "ssh_port": {
      "type": "integer",
      "title": "Git SSH TCP port",
      "description": "Externally allocated NS8 TCP port forwarded to Gitea SSH.",
      "minimum": 0,
      "maximum": 65535
    },
    "setup_mode": {
      "type": "string",
      "title": "Initial setup mode",
      "enum": ["pending", "manual", "managed"]
    },
    "ad_enabled": {
      "type": "boolean",
      "title": "Active Directory authentication enabled"
    },
    "ad_domain": {
      "type": "string",
      "title": "NS8 Active Directory domain"
    },
    "ad_user_group": {
      "type": "string",
      "title": "Allowed AD group"
    },
    "ad_admin_group": {
      "type": "string",
      "title": "Gitea administrators AD group"
    },
    "ad_user_search_base": {
      "type": "string",
      "title": "AD user search base"
    },
    "ad_nested_groups": {
      "type": "boolean",
      "title": "Accept nested AD group membership"
    }
  }
}
