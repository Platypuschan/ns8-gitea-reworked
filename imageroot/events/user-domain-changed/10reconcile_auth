import json
import subprocess
import sys

import agent


def parse_bool(value):
    return str(value).strip().lower() in {"1", "true", "yes", "on"}


try:
    event = json.load(sys.stdin)
except (json.JSONDecodeError, TypeError):
    sys.exit(0)

try:
    config = agent.read_envfile("gitea-auth.env")
except FileNotFoundError:
    sys.exit(0)

try:
    sso = agent.read_envfile("gitea-sso.env")
except FileNotFoundError:
    sso = {}

ad_domain = config.get("GITEA_AUTH_DOMAIN", "").strip()
sso_domain = sso.get("GITEA_SSO_DOMAIN", "").strip()
domains = set()
if parse_bool(config.get("GITEA_AUTH_ENABLED", "false")) and ad_domain in event.get("domains", []):
    domains.add(ad_domain)
if sso_domain and sso_domain in event.get("domains", []):
    domains.add(sso_domain)
if not domains:
    sys.exit(0)

# A restore into a cluster without this domain cannot bind it yet. Retry the
# NS8 domain relation when the domain is added; reconciliation below then
# activates the managed sources if the application is running. Keep the other
# configured domain bound as well: binding replaces the whole list.
bound = set(domains)
if parse_bool(config.get("GITEA_AUTH_ENABLED", "false")) and ad_domain:
    bound.add(ad_domain)
if sso_domain:
    bound.add(sso_domain)
agent.bind_user_domains(sorted(bound), check=False)

if subprocess.run(
    ["systemctl", "--user", "is-active", "--quiet", "gitea-app.service"],
    check=False,
).returncode == 0:
    # Gitea must remain available if AD is temporarily unreachable. A future
    # domain event or service restart retries this idempotent reconciliation.
    subprocess.run(["runagent", "reconcile-gitea-auth"], check=False)
