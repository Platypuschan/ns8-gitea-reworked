[Unit]
Description=Gitea Pod
Requires=postgresql-app.service gitea-app.service
Before=postgresql-app.service gitea-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=-%E/state/environment
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/gitea.pid %t/gitea.pod-id
ExecStartPre=/usr/bin/podman pod create --infra-conmon-pidfile %t/gitea.pid \
    --pod-id-file %t/gitea.pod-id \
    --name gitea \
    --network=slirp4netns:allow_host_loopback=true \
    --publish 127.0.0.1:${TCP_PORT}:3000 \
    --publish ${SSH_TCP_PORT}:22 \
    --replace
ExecStart=/usr/bin/podman pod start --pod-id-file %t/gitea.pod-id
ExecStop=/usr/bin/podman pod stop --ignore --pod-id-file %t/gitea.pod-id -t 10
ExecStopPost=/usr/bin/podman pod rm --ignore -f --pod-id-file %t/gitea.pod-id
PIDFile=%t/gitea.pid
Type=forking

[Install]
WantedBy=default.target
