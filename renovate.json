{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>NethServer/.github:ns8"],
  "automerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the official Gitea container image",
      "fileMatch": ["(^|/)build-images\\.sh$"],
      "matchStrings": [
        "gitea_image=\"(?<depName>docker\\.gitea\\.com/gitea):(?<currentValue>[-0-9A-Za-z_.]+)\""
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
